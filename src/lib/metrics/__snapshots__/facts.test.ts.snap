exports[`fact SQL snapshots > popupRangePath {"since":"2026-09-20","until":"2026-09-26","sites":[]} 1`] = `
{
  "binds": [
    1790438400000,
    1790395200000,
    1790395200000,
    1790439996000,
    1789876800000,
    1790481600000,
  ],
  "db": "gss_geo",
  "sql": "SELECT CASE WHEN ts >= ? THEN 3 WHEN ts >= ? THEN 2 WHEN ts >= ? THEN 1 ELSE 0 END AS s, path, (ts >= ?) AS pf, COUNT(*) AS c FROM hits WHERE ts >= ? AND ts < ? AND (path = '/signin-prompt' OR path LIKE '/signin-prompt/%' OR path = '/signin-eligible' OR path LIKE '/signin-eligible/%' OR path = '/promo-first50' OR path LIKE '/promo-first50/%' OR path = '/first50-congrats' OR path LIKE '/first50-congrats/%' OR path = '/upsell' OR path LIKE '/upsell/%' OR path = '/install' OR path LIKE '/install/%' OR path = '/popup-outcome' OR path LIKE '/popup-outcome/%' OR path = '/return' OR path LIKE '/return/%' OR path LIKE '/game/complete/%' OR path LIKE '/game/complete-deferred/%' OR path LIKE '/auth/success/google/%' OR path LIKE '/auth/success/email/%' OR path = '/auth/error' OR path LIKE '/auth/error/%' OR path = '/auth/redirect' OR path LIKE '/auth/redirect/%' OR path = '/tour' OR path LIKE '/tour/%' OR path = '/game/tutorial-complete' OR path LIKE '/game/tutorial-complete/%' OR path = '/game/first-move' OR path LIKE '/game/first-move/%' OR path = '/game/abandon' OR path LIKE '/game/abandon/%' OR path = '/welcome-signed-in' OR path LIKE '/welcome-signed-in/%' OR path LIKE '/game/start/%') GROUP BY s, path, pf",
}
`;

