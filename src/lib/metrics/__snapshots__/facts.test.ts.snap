exports[`fact SQL snapshots > adsInstallsDaily {} 1`] = `
{
  "binds": [
    "24392866056",
    "7756366796",
    "24392866056",
  ],
  "db": "gss_stats_ads",
  "sql": "SELECT m.campaign_id AS campaign_id, m.date AS date, COALESCE(SUM(c.conversions), 0) AS installs FROM ads_daily_metrics AS m LEFT JOIN ads_daily_conversions AS c ON c.campaign_id = m.campaign_id AND c.date = m.date AND c.conversion_action_id = (CASE m.campaign_id WHEN ? THEN ? END) WHERE m.campaign_id IN (?) AND m.date <= (SELECT MAX(x.date) FROM ads_daily_conversions AS x WHERE x.campaign_id = m.campaign_id) GROUP BY m.campaign_id, m.date ORDER BY m.campaign_id, m.date",
}
`;

exports[`fact SQL snapshots > adsLastSync {} 1`] = `
{
  "binds": [],
  "db": "gss_stats_ads",
  "sql": "SELECT j.value AS campaign_id, MAX(r.finished_at) AS last_sync FROM (SELECT campaigns_ok, finished_at FROM ads_sync_runs WHERE status <> 'running' AND run_key NOT LIKE 'extras:%' ORDER BY finished_at DESC LIMIT 50) AS r, json_each(r.campaigns_ok) AS j GROUP BY j.value",
}
`;

exports[`fact SQL snapshots > adsPlayDaily {} 1`] = `
{
  "binds": [],
  "db": "gss_stats_ads",
  "sql": "SELECT date, device_installs, user_installs, device_uninstalls, active_device_installs FROM ads_play_daily ORDER BY date",
}
`;

exports[`fact SQL snapshots > adsSpend {} 1`] = `
{
  "binds": [],
  "db": "gss_stats_ads",
  "sql": "SELECT campaign_id, SUM(cost_micros) AS cost_micros, SUM(CASE WHEN date >= '2026-10-27' THEN cost_micros ELSE 0 END) AS cost_micros_from_first_finish, SUM(impressions) AS impressions, SUM(clicks) AS clicks, COUNT(*) AS days, MIN(date) AS first_date, MAX(date) AS last_date, MAX(fetched_at) AS fetched_at FROM ads_daily_metrics GROUP BY campaign_id",
}
`;

