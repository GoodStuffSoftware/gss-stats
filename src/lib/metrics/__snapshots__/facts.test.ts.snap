    1280,
    "North Carolina",
    "/popup-outcome/install-prompt/installed",
    "/install/pwa-installed",
    1790439996000,
  ],
  "db": "gss_geo",
  "sql": "SELECT CASE WHEN ts >= ? AND ts < ? THEN 0 WHEN ts >= ? AND ts < ? THEN 1 WHEN ts >= ? AND ts < ? THEN 2 WHEN ts >= ? AND ts < ? THEN 3 WHEN ts >= ? AND ts < ? THEN 4 WHEN ts >= ? AND ts < ? THEN 5 WHEN ts >= ? AND ts < ? THEN 6 WHEN ts >= ? AND ts < ? THEN 7 ELSE -1 END AS d, CASE WHEN ts >= ? THEN 8 WHEN ts >= ? THEN 7 WHEN ts >= ? THEN 6 WHEN ts >= ? THEN 5 WHEN ts >= ? THEN 4 WHEN ts >= ? THEN 3 WHEN ts >= ? THEN 2 WHEN ts >= ? THEN 1 ELSE 0 END AS s, path, visitor, campaign, COUNT(*) AS c FROM hits WHERE site IN (?, ?, ?) AND ts >= ? AND ts < ? AND NOT (medium = ? OR campaign LIKE ?) AND NOT (region = ? AND city = ? AND org = ? AND device = ? AND os = ? AND browser = ? AND screenw = ?) AND NOT (region = ? AND screenw IN (412, 444, 852)) AND NOT (path IN (?, ?) AND ts < ?) GROUP BY d, s, path, visitor, campaign HAVING d >= 0",
}
`;

