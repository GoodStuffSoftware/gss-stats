exports[`fact SQL snapshots > bskKpiDays {"todayEt":"2026-09-26"} 1`] = `
{
  "binds": [
    "bestsudoku-web",
    "bestsudoku",
    "bestsudoku-app",
    1789790400000,
    1790456400000,
    "lifecycle",
    "email_%",
    "Virginia",
    "Reston",
    "Verizon Business",
    "desktop",
    "Windows",
    "Chrome",
    1280,
    "North Carolina",
    "/popup-outcome/install-prompt/installed",
    "/install/pwa-installed",
    1790439996000,
  ],
  "db": "gss_geo",
  "sql": "SELECT CASE WHEN ts >= 1790395200000 THEN 0 WHEN ts >= 1790308800000 THEN 1 WHEN ts >= 1790222400000 THEN 2 WHEN ts >= 1790136000000 THEN 3 WHEN ts >= 1790049600000 THEN 4 WHEN ts >= 1789963200000 THEN 5 WHEN ts >= 1789876800000 THEN 6 WHEN ts >= 1789790400000 THEN 7 ELSE -1 END AS d, CASE WHEN (path LIKE '/return/%' OR path LIKE '/game/complete/%' OR path LIKE '/game/complete-deferred/%' OR path LIKE '/game/tutorial-complete/%' OR path LIKE '/game/start/%' OR path LIKE '/tour/exit-at/%' OR path LIKE '/tour/exit-at' OR path LIKE '/tour/skip' OR path LIKE '/tour/skip/%' OR path LIKE '/coach/dismissed/%' OR path LIKE '/coach/closed-at/%' OR path LIKE '/coach/shown/%' OR path LIKE '/ab/ask-order/%' OR path LIKE '/funnel/%' OR path LIKE '/game/first-finish' OR path LIKE '/signin-prompt/first-finish' OR path LIKE '/signin-eligible/earned/first-finish' OR path LIKE '/popup-outcome/signin-prompt/first-finish/%' OR instr(path, char(0)) > 0) THEN 0 WHEN ts >= 1790308800000 AND ts < 1790370000000 THEN 1 WHEN ts >= 1790222400000 AND ts < 1790283600000 THEN 1 WHEN ts >= 1790136000000 AND ts < 1790197200000 THEN 1 WHEN ts >= 1790049600000 AND ts < 1790110800000 THEN 1 WHEN ts >= 1789963200000 AND ts < 1790024400000 THEN 1 WHEN ts >= 1789876800000 AND ts < 1789938000000 THEN 1 WHEN ts >= 1789790400000 AND ts < 1789851600000 THEN 1 ELSE 0 END AS t, CASE WHEN ts >= 1793030400000 THEN 10 WHEN ts >= 1791129600000 THEN 9 WHEN ts >= 1791046980000 THEN 8 WHEN ts >= 1790451780000 THEN 7 WHEN ts >= 1790439960000 THEN 6 WHEN ts >= 1790438400000 THEN 5 WHEN ts >= 1790395200000 THEN 4 WHEN ts >= 1790049600000 THEN 3 WHEN ts >= 1788926400000 THEN 2 WHEN ts >= 1788321600000 THEN 1 ELSE 0 END AS s, path, visitor, campaign, COUNT(*) AS c FROM hits WHERE site IN (?, ?, ?) AND ts >= ? AND ts < ? AND NOT (medium = ? OR campaign LIKE ?) AND NOT (region = ? AND city = ? AND org = ? AND device = ? AND os = ? AND browser = ? AND screenw = ?) AND NOT (region = ? AND screenw IN (412, 444, 852)) AND (COALESCE(campaign, '') <> 'manual_check' AND COALESCE(path, '') NOT LIKE '/return/manual\\_check/%' ESCAPE '\\') AND NOT (path IN (?, ?) AND ts < ?) GROUP BY d, t, s, path, visitor, campaign HAVING d >= 0",
}
`;

