# Local dev secrets for `wrangler pages dev`. Copy to .dev.vars (gitignored).
# Value = a Cloudflare API token with Account Analytics Read.
CF_ANALYTICS_TOKEN=your-cloudflare-analytics-token
# The Cloudflare account id (32 hex, dashboard → Account home → Account ID). Env data: never commit it.
CF_ACCOUNT_ID=your-32-hex-cloudflare-account-id

# Sign-in (README "Auth"). Pick ONE of the two options below.
#
# (a) Skip Google locally. Only the exact value 1 turns it on, and only when the request
#     host is localhost/127.0.0.1, so it can never open the deployed site. Without it
#     (and without (b)) every request gets a 503 "sign-in not configured".
#     AUTH_DEV_EMAIL is the identity shown in the header (default dev@localhost).
#     NEVER combine this with `wrangler pages dev --ip 0.0.0.0` (or any network-bound
#     dev server): the loopback check trusts the Host header, so anyone on the network
#     sending "Host: localhost" would get the bypass and your analytics data.
AUTH_DEV_BYPASS=1
# AUTH_DEV_EMAIL=you@example.com
#
# (b) Run the real Google flow locally: remove AUTH_DEV_BYPASS and fill these in with a
#     SEPARATE dev OAuth client whose only redirect URI is
#     http://localhost:8788/auth/google/callback. Never put the production client's
#     secret here (README "Auth" → Local development).
#     SESSION_SECRET must be 32+ random characters; SESSION_TTL_HOURS, if set, a number
#     from 1 to 720.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=
# ALLOWED_EMAILS=you@example.com
# SESSION_TTL_HOURS=168

# Budget email receipts (README "Budget"; the gss-budget-receipts Worker is not run by `wrangler pages dev`,
# so locally the email routes answer "not configured" unless you also run it and add the RECEIPTS binding).
# The Gmail OAuth client id (public identifier, but set per environment). Made-up placeholder:
RECEIPTS_GMAIL_CLIENT_ID=your-gmail-oauth-client-id
# "fields" = each listed Budget person sees the other's receipt fields; "none" = owner only.
RECEIPTS_SHARE=fields
# Worker-only secrets (Secrets Store, never in .dev.vars or the repo): RECEIPTS_GMAIL_CLIENT_SECRET,
# RECEIPTS_TOKEN_KEY, RECEIPTS_TOKEN_KEY_OLD, RECEIPTS_ANTHROPIC_KEY, RECEIPTS_ALLOWED_EMAILS.

# Budget bank links (README "Budget"): the Pages side needs no bank secret or var, only the BANKS service
# binding in wrangler.toml. Plaid and bank-token secrets are NEVER in .dev.vars: they live in the Secrets Store
# of the gss-budget-banks Worker (README "Bank links in the Plaid sandbox" for the local, sandbox-only setup).
