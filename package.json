{
  "name": "gss-stats",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "Private bot-free traffic dashboard for Good Stuff Software (RUM via Cloudflare GraphQL).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts/ads-reads/tsconfig.json --noEmit && tsc -p scripts/metrics/tsconfig.json --noEmit",
    "ads:morning-read": "tsx scripts/ads-reads/morning-read.ts",
    "ads:postflight-read": "tsx scripts/ads-reads/postflight-read.ts",
    "ads:read-page": "tsx scripts/ads-reads/read-page.ts",
    "ads:backfill": "tsx scripts/ads-reads/backfill.ts",
    "ads:sync": "tsx scripts/ads-reads/sync.ts",
    "ads:worker-secrets": "tsx scripts/ads-reads/worker-secrets.ts",
    "ads:worker-deploy": "tsx scripts/ads-reads/worker-deploy.ts",
    "ads:worker-check": "wrangler deploy --dry-run -c workers/sync/wrangler.toml --outdir .wrangler/worker-check",
    "ads:migrate": "wrangler d1 migrations apply gss-stats-ads --remote",
    "metrics:capture": "tsx scripts/metrics/capture-facts.ts",
    "metrics:profile": "tsx scripts/metrics/profile-metrics.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.49.0",
    "chart.js": "^4.4.7",
    "grid-layout-plus": "^1.0.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/node": "^24.19.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "workerd": "^1.20260926.1",
    "wrangler": "^4.143.0"
  }
}
